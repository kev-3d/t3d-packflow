# Copy to .env and adjust. Docker Compose reads .env automatically.

# Production stack (docker-compose.yml)
PACKFLOW_PORT=10000

# Development stack (compose.dev.yml)
PACKFLOW_API_PORT=8001
PACKFLOW_WEB_PORT=5173

# Load the 16 reference products and 13 box types at startup (true/false).
# Defaults: true in production stack, false in development stack.
# PACKFLOW_SEED_REFERENCE_CATALOG=true

# Database. Empty -> SQLite at PACKFLOW_DB_PATH (backend/data/packflow.db).
# Set to a PostgreSQL URL to use PostgreSQL, e.g.
# DATABASE_URL=postgresql://packflow:packflow@localhost:5432/packflow
# For managed providers add TLS: ?sslmode=require
# DATABASE_URL=
# Pool size for PostgreSQL connections.
# PACKFLOW_DB_POOL_MAX=5

# ---------- Authentication (Clerk) ----------
# Keys from the Clerk dashboard (API keys). Use the Development instance for dev/test.
# Without both keys every API call except /api/health answers 503 (fails closed).
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# Origins allowed in the token's azp claim (recommended), e.g. the dev URL and Vite:
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:10000
# Email domains that may sign in without an invitation (they get the "user" role):
# AUTH_ALLOWED_EMAIL_DOMAINS=yourcompany.com
# Emails created as administrators at startup when missing (no shell needed):
# AUTH_BOOTSTRAP_ADMINS=admin1@yourcompany.com,admin2@yourcompany.com
# Where Clerk invitation links send people (the app URL):
# AUTH_APP_URL=http://localhost:5173
